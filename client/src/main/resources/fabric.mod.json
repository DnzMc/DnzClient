{
	"schemaVersion": 1,
	"id": "dnzclient",
	"version": "${version}",
	"name": "DNZ Client",
	"description": "Modern pause menu with skin changer. Powered by Sodium and Sodium Extra.",
	"authors": ["DNZ"],
	"license": "GPL-3.0-only",
	"icon": "assets/dnzclient/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.dnz.client.DnzClient", "com.dnz.client.FriendsInit"]
	},
	"mixins": ["dnzclient.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~${mc}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"jars": [
		{"file": "META-INF/jars/${worldHost}"}
	],
	"recommends": {
		"sodium": "*",
		"sodium-extra": "*",
		"modmenu": "*"
	}
}
